MAIL_DOMAIN=example.com
POSTFIX_HOSTNAME=mx1.example.com
# PUBLIC_IPV4=
# PUBLIC_HOSTNAME=
CADDY_DOMAIN=mx1.example.com
CADDY_HTTP_PORT=60080
CADDY_HTTPS_PORT=60443
ACME_EMAIL=admin@example.com
MYNETWORKS=127.0.0.0/8 [::1]/128 172.18.0.0/16
DKIM_SELECTOR=mail
SMTP_PUBLISHED_PORT=2525
SUBMISSION_PUBLISHED_PORT=1587
# POSTFIX_SMTP_TLS=true

JWT_SECRET=dev-only-change-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
MFA_ISSUER=Mail Exchange

# Sync tra server Mail Exchange indipendenti (opzionale)
# SYNC_SHARED_SECRET=change-me-same-on-both-servers
# SYNC_TLS_VERIFY=true

# Docker Hub (deploy senza build locale — vedi README)
# Namespace: utente o org Docker Hub (solo minuscolo, es. cybercecco)
# DOCKERHUB_NAMESPACE=cybercecco
# MAIL_EXCHANGE_IMAGE_TAG=latest
