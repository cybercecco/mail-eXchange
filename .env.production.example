MAIL_DOMAIN=vetrobalsamo.com
POSTFIX_HOSTNAME=smtp.inxpire.support
# Optional: force public IP(s) for DNS/SPF suggestions (comma-separated IPv4)
# PUBLIC_IPV4=20.224.45.120
# Optional: resolve a different hostname for public A/AAAA (defaults to POSTFIX_HOSTNAME)
# PUBLIC_HOSTNAME=smtp.inxpire.support
CADDY_DOMAIN=smtp.inxpire.support
CADDY_HTTP_PORT=60080
CADDY_HTTPS_PORT=60443
ACME_EMAIL=admin@inxpire.support
# Token API Cloudflare (DNS Edit) per certificati Let's Encrypt via Caddy DNS-01
# CLOUDFLARE_API_TOKEN=
# DNS resolver per i container Docker (spazi o virgole; sovrascrivibile da Configurazione)
DOCKER_DNS_SERVERS=208.67.222.222 208.67.220.220
MYNETWORKS=127.0.0.0/8 [::1]/128 172.16.0.0/12 192.168.1.70/32 46.44.206.138/32 46.44.206.139/32
DKIM_SELECTOR=mail
SMTP_PUBLISHED_PORT=25
SUBMISSION_PUBLISHED_PORT=587
# Internal API→Postfix (postfix:25): plain SMTP unless smtpd TLS certs are configured
# POSTFIX_SMTP_TLS=true

# Control plane auth (set strong values; never commit real passwords)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-deploy
MFA_ISSUER=Mail Exchange

# Sync cluster: chiave precondivisa per dominio (tab Cluster in UI), non più in .env
# SYNC_TLS_VERIFY=true
