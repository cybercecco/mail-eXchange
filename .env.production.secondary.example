# Esempio per il nodo B — copia in .env.production.secondary (non committare):
#   cp .env.production.secondary.example .env.production.secondary
#   # modifica segreti/host, poi:
#   ./deploy.sh root@192.168.1.69 /opt/mail-exchange .env.production.secondary
#
# Adattare almeno:
POSTFIX_HOSTNAME=smtp.vetrobalsamo.com
PUBLIC_HOSTNAME=smtp.vetrobalsamo.com
CADDY_DOMAIN=smtp.vetrobalsamo.com
# PUBLIC_IPV4=...   # se IP pubblico diverso dal nodo A
# Chiave sync cluster: impostarla nel tab Cluster di ogni dominio (stesso valore su entrambi i nodi)
#
# Porte host (60080/60443, 25/587) possono restare uguali su host diversi.
# TLS: senza CLOUDFLARE_API_TOKEN in .env → HTTP :60080 + HTTPS interno; con token → LE DNS-01.
# CLOUDFLARE_API_TOKEN=
